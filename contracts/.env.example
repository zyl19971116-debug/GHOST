# ===========================================================================
# GHOST PROTOCOL AI — contract deployment environment
# Copy to contracts/.env and fill in. NEVER commit contracts/.env.
# ===========================================================================

# Deployer key. FUND THIS ACCOUNT WITH A THROWAWAY KEY ONLY.
# The contract can never move funds, but a leaked key can still be abused for gas.
DEPLOYER_PRIVATE_KEY=

# Override the RPC endpoints if you have a dedicated provider.
# Defaults (public, rate limited) are baked into hardhat.config.js:
#   mainnet  https://rpc.mainnet.chain.robinhood.com   chainId 4663
#   testnet  https://rpc.testnet.chain.robinhood.com   chainId 46630
RH_MAINNET_RPC_URL=
RH_TESTNET_RPC_URL=

# Blockscout-style explorer API key. Public Blockscout instances usually accept
# any non-empty value; leave blank to use the placeholder.
RH_EXPLORER_API_KEY=
