# ============================================================================
# GHOST PROTOCOL AI — environment configuration
# Copy to `.env.local` (never commit it) and fill in what you have.
#
# EVERY value here is OPTIONAL. The app is designed to boot and be fully
# navigable with an empty .env. Anything missing is surfaced in the UI as
# "NOT CONFIGURED" instead of being faked.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. CHAIN ACCESS
# ---------------------------------------------------------------------------
# Comma-separated chain keys to enable, in priority order.
# Supported: robinhood, robinhoodTestnet, ethereum, base, arbitrum, optimism, polygon
NEXT_PUBLIC_CHAINS=robinhood,robinhoodTestnet,ethereum,base

# Default chain shown on first load (must be one of the keys above).
NEXT_PUBLIC_DEFAULT_CHAIN=robinhood

# --- RPC endpoints --------------------------------------------------------
# The public Robinhood Chain RPC works out of the box for reads.
# For production use a dedicated provider (Alchemy / QuickNode / Blockdaemon /
# dRPC / Validation Cloud) — the public endpoint is rate limited.
#
# Server-side RPC (never exposed to the browser).
RPC_URL_ROBINHOOD=https://rpc.mainnet.chain.robinhood.com
RPC_URL_ROBINHOOD_TESTNET=https://rpc.testnet.chain.robinhood.com
RPC_URL_ETHEREUM=
RPC_URL_BASE=
RPC_URL_ARBITRUM=
RPC_URL_OPTIMISM=
RPC_URL_POLYGON=

# Browser-side RPC. Leave blank to reuse the server URLs above (they are
# public read endpoints). Do NOT put a paid key here — it ships to the client.
NEXT_PUBLIC_RPC_URL_ROBINHOOD=
NEXT_PUBLIC_RPC_URL_ROBINHOOD_TESTNET=
NEXT_PUBLIC_RPC_URL_ETHEREUM=
NEXT_PUBLIC_RPC_URL_BASE=

# ---------------------------------------------------------------------------
# 2. BLOCK EXPLORER / INDEXER (optional, improves history coverage)
# ---------------------------------------------------------------------------
# When set, the explorer adapter is used IN ADDITION to the RPC scanner.
# NOTE: robinhoodchain.blockscout.com sits behind a Cloudflare bot challenge
# and returns HTTP 403 to server-side requests, so it is NOT enabled by
# default. Point EXPLORER_API_URL at a provider that allows server access
# (e.g. your own Blockscout instance, or an Etherscan-compatible indexer).
EXPLORER_API_URL_ROBINHOOD=
EXPLORER_API_KEY_ROBINHOOD=
# Etherscan-compatible API key for other chains, if you add them.
EXPLORER_API_URL_ETHEREUM=
EXPLORER_API_KEY_ETHEREUM=

# ---------------------------------------------------------------------------
# 3. DATA-LAYER LIMITS (sane defaults; tune to your provider's quota)
# ---------------------------------------------------------------------------
# How many blocks the RPC scanner walks back when no indexer is available.
# Robinhood Chain produces ~10 blocks/second, so 3000 blocks ≈ 5 minutes of
# chain time. Higher = slower + more RPC calls. Hard ceiling: 20000.
SCAN_MAX_BLOCKS=3000
# Max blocks to request per JSON-RPC batch. The public RPC 429s above ~100.
SCAN_BATCH_SIZE=50
# Max concurrent in-flight RPC requests for the whole server.
RPC_MAX_CONCURRENCY=4
# Per-request timeout in milliseconds.
RPC_TIMEOUT_MS=20000
# Max retry attempts on 429 / 5xx / network errors (exponential backoff).
RPC_MAX_RETRIES=3
# In-memory response cache TTL in seconds.
CACHE_TTL_SECONDS=45
# Sliding-window rate limit for the public API routes (requests / window).
API_RATE_LIMIT_MAX=60
API_RATE_LIMIT_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# 4. AI ANALYSIS (optional)
# ---------------------------------------------------------------------------
# Leave AI_API_KEY blank and the deterministic engine still works; the AI
# section of /analyze then renders "AI NOT CONFIGURED".
# OpenAI-compatible chat-completions endpoint.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=45000
AI_MAX_OUTPUT_TOKENS=1600

# ---------------------------------------------------------------------------
# 5. DATABASE (optional)
# ---------------------------------------------------------------------------
# Leave blank to use the built-in in-memory repository (works, but data is
# lost on restart and is not shared between processes).
# DATABASE_URL="postgresql://user:password@localhost:5432/ghostprotocol?schema=public"
DATABASE_URL=

# ---------------------------------------------------------------------------
# 6. WALLET CONNECT
# ---------------------------------------------------------------------------
# Get a free project id at https://cloud.walletconnect.com
# Without it, injected wallets (MetaMask / Rabby) still work; WalletConnect
# and the RainbowKit mobile QR flow are hidden/disabled.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------
# 7. ANALYSIS REGISTRY CONTRACT (optional)
# ---------------------------------------------------------------------------
# Address of the deployed AnalysisRegistry contract. Leave blank and the UI
# shows "NOT DEPLOYED" — it never pretends the contract is live.
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_REGISTRY_CHAIN_ID=4663

# ---------------------------------------------------------------------------
# 8. SITE
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# 9. CONTRACTS TOOLING (contracts/ package only — never used by the web app)
# ---------------------------------------------------------------------------
DEPLOYER_PRIVATE_KEY=
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Blockscout verification. The public instance is Cloudflare-protected; use
# `--network robinhoodTestnet` or your own instance if verification is blocked.
RH_VERIFIER_URL=https://robinhoodchain.blockscout.com/api/
