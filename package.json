{
  "name": "ghost-protocol-ai",
  "version": "0.1.0",
  "private": true,
  "description": "GHOST PROTOCOL AI - The Invisible Intelligence Layer. On-chain wallet relationship analysis platform.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "preflight": "tsc -p tsconfig.test.json && node scripts/preflight.mjs",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/",
    "test:only": "node --test .test-build/tests/",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "contracts:install": "npm --prefix contracts install",
    "contracts:compile": "npm --prefix contracts run compile",
    "contracts:test": "npm --prefix contracts run test",
    "contracts:deploy": "npm --prefix contracts run deploy --",
    "contracts:verify": "npm --prefix contracts run verify --",
    "verify:routes": "node scripts/verify-routes.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.2.1",
    "@rainbow-me/rainbowkit": "2.2.1",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.6",
    "@react-three/fiber": "8.17.10",
    "@tanstack/react-query": "5.62.16",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "11.18.2",
    "lucide-react": "0.469.0",
    "next": "14.2.33",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.6.0",
    "three": "0.171.0",
    "viem": "2.22.8",
    "wagmi": "2.14.7",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/three": "0.171.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.1",
    "prisma": "6.2.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
